#!/bin/sh

NIX_DAEMON=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
if [ -f $NIX_DAEMON ] || command -v nix &> /dev/null ; then
	echo "Nix is already installed."
	. $NIX_DAEMON
	return 0
else
	return 1
fi
export PATH=$PATH:$HOME/.nix-profile/bin/:/run/current-system/sw/bin
export SHELL=$(which zsh)

ZSHRC=~/.config/zsh/zshrc
if [ -r $ZSHRC  ]; then
    source $ZSHRC
fi

. "$HOME/.local/bin/env"

# >>> headroom persistent env >>>
export HEADROOM_PORT="8787"
export HEADROOM_HOST="127.0.0.1"
export HEADROOM_MODE="cache"
export HEADROOM_BACKEND="anthropic"
export HEADROOM_TELEMETRY="off"
export COPILOT_PROVIDER_TYPE="anthropic"
export COPILOT_PROVIDER_BASE_URL="http://127.0.0.1:8787"
export OPENAI_BASE_URL="http://127.0.0.1:8787/v1"
export ANTHROPIC_BASE_URL="http://127.0.0.1:8787"
# <<< headroom persistent env <<<
